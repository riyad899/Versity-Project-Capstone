{
  "info": {
    "_postman_id": "driver-trip-and-live-location-api",
    "name": "Driver Trip & Live Location API Collection",
    "description": "Comprehensive Postman test collection for [Member 3] Driver Trip Management & Live GPS Location Sharing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5009",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "tripId",
      "value": "YOUR_ACTIVE_TRIP_ID_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Driver Login (Obtain Auth Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.token) {",
              "        pm.collectionVariables.set('token', jsonData.data.token);",
              "        console.log('Driver Token Saved:', jsonData.data.token);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"driver@gmail.com\",\n  \"password\": \"12345678\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "1. GET Active Trip for Driver",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data._id) {",
              "        pm.collectionVariables.set('tripId', jsonData.data._id);",
              "        console.log('Active Trip ID Set:', jsonData.data._id);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/trips/active",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "trips", "active"]
        }
      }
    },
    {
      "name": "2. POST Start Trip (Drivers)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data._id) {",
              "        pm.collectionVariables.set('tripId', jsonData.data._id);",
              "        console.log('New Trip Started with ID:', jsonData.data._id);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"initialLatitude\": 23.8103,\n  \"initialLongitude\": 90.4125,\n  \"remarks\": \"Starting regular scheduled campus route\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/trips/start",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "trips", "start"]
        }
      }
    },
    {
      "name": "3. POST Broadcast Live GPS Location",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 23.8125,\n  \"longitude\": 90.4140,\n  \"speed\": 38.5,\n  \"heading\": 85\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/trips/{{tripId}}/location",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "trips", "{{tripId}}", "location"]
        }
      }
    },
    {
      "name": "4. GET All Live Trips (Passengers & Management)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/trips/live",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "trips", "live"]
        }
      }
    },
    {
      "name": "5. PATCH Stop / Complete Trip",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"remarks\": \"Arrived at destination terminal safely without issues.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/trips/{{tripId}}/stop",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "trips", "{{tripId}}", "stop"]
        }
      }
    },
    {
      "name": "6. GET Driver Trip History",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/trips/history",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "trips", "history"]
        }
      }
    },
    {
      "name": "7. (Error Test) Start Trip When One Is Already Active",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"remarks\": \"Attempt duplicate trip start\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/trips/start",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "trips", "start"]
        }
      }
    }
  ]
}
